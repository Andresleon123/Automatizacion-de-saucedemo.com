// Aplicación de plugins
plugins {
    id 'java'
}

// Configuración básica del proyecto
group 'com.saucedemo'
version '1.0-SNAPSHOT'

// Repositories
repositories {
    mavenCentral()
    jcenter()
    maven { url 'https://plugins.gradle.org/m2/' }  // Asegúrate de que se especifique el repositorio del plugin
}

// Tareas por
defaultTasks 'clean', 'test', 'aggregate'

dependencies {
    // Serenity + Cucumber
    testImplementation 'net.serenity-bdd:serenity-core:4.0.30'
    testImplementation 'net.serenity-bdd:serenity-junit:4.0.30'
    implementation 'net.serenity-bdd:serenity-screenplay:4.0.30'
    implementation 'net.serenity-bdd:serenity-screenplay-webdriver:4.0.30'
    implementation 'net.serenity-bdd:serenity-ensure:4.0.30'
    implementation 'net.serenity-bdd:serenity-cucumber:4.0.30'
    implementation 'io.cucumber:cucumber-java:6.11.0'
    implementation 'io.cucumber:cucumber-junit:6.11.0'

    // JUnit 4
    implementation 'junit:junit:4.13.2'
}

test {
    useJUnit()  // Aquí decimos: Usar JUnit 4, NO JUnit Platform (que es para JUnit 5)
    systemProperty 'webdriver.driver', System.getProperty('webdriver.driver', 'chrome')
}
